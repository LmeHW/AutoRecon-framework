# Shared AutoRecon runtime. Override this only when the runtime is stored elsewhere.
AUTORECON_RUNTIME_ROOT=/mnt/sda/huangwei/projects/AutoRecon/.runtime

# Apptainer is a host-side launcher, not a SIF image. The runtime scripts first
# use APPTAINER_BIN, then PATH, then this installation discovered on this server.
APPTAINER_BIN=/mnt/sda/huangwei/conda_envs/apptainer/bin/apptainer

# Writable cache/tmp paths are intentionally outside the read-only SIF images.
APPTAINER_CACHEDIR=/mnt/sda/huangwei/projects/AutoRecon/.runtime/model_cache/apptainer
APPTAINER_TMPDIR=/mnt/sda/huangwei/projects/AutoRecon/.runtime/tmp/apptainer

# Container filenames are stable public interfaces used by the pipeline.
FROST_SIF=/mnt/sda/huangwei/projects/AutoRecon/.runtime/containers/frost.sif
EXTRACTION_NNUNET_SIF=/mnt/sda/huangwei/projects/AutoRecon/.runtime/containers/extraction_nnunet.sif
TISSUE_NNUNET_SIF=/mnt/sda/huangwei/projects/AutoRecon/.runtime/containers/tissue_nnunet.sif
NESVOR_SIF=/mnt/sda/huangwei/projects/AutoRecon/.runtime/containers/nesvor_v0.5.0.sif
AUTOSVRTK_SIF=/mnt/sda/huangwei/projects/AutoRecon/.runtime/containers/autosvrtk_general_auto_amd.sif
NIFTYMIC_SIF=/mnt/sda/huangwei/projects/AutoRecon/.runtime/containers/niftymic.sif
