{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "UserRequest",
  "type": "object",
  "required": ["raw_text", "task_type", "execution_mode"],
  "properties": {
    "raw_text": {"type": "string"},
    "task_type": {"type": "string"},
    "intent": {"type": "string"},
    "subject_dir": {"type": ["string", "null"]},
    "work_root": {"type": ["string", "null"]},
    "gestational_age": {"type": ["number", "null"]},
    "fetal_description": {"type": ["string", "null"]},
    "clinical_status": {"type": ["string", "null"], "enum": ["none", "present", "unknown", null]},
    "clinical_condition": {"type": ["string", "null"]},
    "clinical_notes": {"type": ["string", "null"]},
    "atlas": {"type": ["string", "null"]},
    "atlas_week": {"type": ["integer", "null"]},
    "atlas_rule": {"type": ["string", "null"]},
    "reconstruction_tool": {"type": "string", "enum": ["frost", "nesvor", "autosvrtk", "niftymic"]},
    "reconstruction_compare_tools": {"type": "array", "uniqueItems": true, "items": {"type": "string", "enum": ["frost", "nesvor", "autosvrtk", "niftymic"]}},
    "roi_mode": {"type": "string", "enum": ["warp", "segresnet", "skip"]},
    "surface": {"type": "string", "enum": ["auto", "on", "off"]},
    "execution_mode": {"type": "string", "enum": ["plan_only", "import_existing", "run_pipeline", "continue_from_run"]},
    "existing_run_dir": {"type": ["string", "null"]},
    "display_steps": {"type": "array", "items": {"type": "string"}},
    "execution_steps": {"type": "array", "items": {"type": "string"}},
    "report_steps": {"type": "array", "items": {"type": "string"}},
    "requested_outputs": {"type": "array", "items": {"type": "string"}},
    "constraints": {"type": "array", "items": {"type": "string"}},
    "unfulfilled_requests": {"type": "array", "items": {"type": "string"}},
    "refusal_explanations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": {"type": "string"},
          "title": {"type": "string"},
          "reason": {"type": "string"},
          "blocks_gpu": {"type": "boolean"}
        }
      }
    },
    "reused_steps": {"type": "array", "items": {"type": "string"}},
    "report_language": {"type": "string"},
    "report_detail": {"type": "string"},
    "report_layout": {"type": "string", "enum": ["combined", "per_step", "per_step_and_final"]},
    "resume": {"type": "boolean"},
    "missing": {"type": "array", "items": {"type": "string"}},
    "warnings": {"type": "array", "items": {"type": "string"}},
    "unsupported_reason": {"type": ["string", "null"]}
  }
}
