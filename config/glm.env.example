# Non-secret GLM / BigModel settings. Copy to config/glm.env and point
# AUTORECON_CONFIG_FILE at that copy. Do not put API keys in this file.
AUTORECON_LLM_ENABLED=true
AUTORECON_LLM_PROVIDER=openai_compatible
AUTORECON_LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
AUTORECON_LLM_MODEL=glm-5.3-flash
AUTORECON_LLM_TIMEOUT_SECONDS=300
AUTORECON_LLM_MAX_RETRIES=4
AUTORECON_LLM_TEMPERATURE=0
AUTORECON_LLM_MAX_OUTPUT_TOKENS=4096

AUTORECON_LLM_USE_FOR_REQUEST_PARSING=true
AUTORECON_LLM_USE_FOR_PLANNING=true
AUTORECON_LLM_USE_FOR_RESULT_ANALYSIS=true
AUTORECON_LLM_USE_FOR_ERROR_ANALYSIS=true
AUTORECON_LLM_USE_FOR_REPORTING=true
AUTORECON_LLM_FALLBACK_TO_RULES=true

AUTORECON_LLM_SAVE_REQUEST=false
AUTORECON_LLM_SAVE_RESPONSE=false

# Replace with local ANTs / ROI-warp environments before running the GPU pipeline.
AUTORECON_ANTS_DIR=/path/to/ants/bin
AUTORECON_ROI_WARP_ENV=/path/to/roi-warp-env
