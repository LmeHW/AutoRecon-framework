# Copy to config/service.env. Do not put passwords in this file.
AUTORECON_GATEWAY_HOST=127.0.0.1
AUTORECON_GATEWAY_PORT=19001
AUTORECON_GATEWAY_DATA=.runtime/gateway

# 单文件上限 2GiB，单用户合计 20GiB。MRI 体积较大时再上调。
AUTORECON_GATEWAY_MAX_UPLOAD_BYTES=2147483648
AUTORECON_GATEWAY_MAX_USER_BYTES=21474836480
AUTORECON_GATEWAY_MAX_CHUNK_BYTES=8388608

# 两张 GPU 时全局可设 2；每账号建议仍限 1，避免单用户占满全部卡。
AUTORECON_GATEWAY_MAX_GLOBAL_JOBS=2
AUTORECON_GATEWAY_MAX_USER_JOBS=1
AUTORECON_GATEWAY_SESSION_HOURS=12
AUTORECON_GATEWAY_RETENTION_DAYS=7

# 首次启动若库中无用户，会生成管理员密码到 $AUTORECON_GATEWAY_DATA/bootstrap_admin.txt
# 不要把真实密码写入本文件或提交到版本库。
# AUTORECON_GATEWAY_BOOTSTRAP_USER=admin
# AUTORECON_GATEWAY_BOOTSTRAP_PASSWORD=

AUTORECON_GATEWAY_ATLAS_DIR=pipeline/data/FBA_Chinese_Atlas/img
